PORT=80
APP_PORT=3000
TRUST_PROXY=true
NGINX_LISTEN_PORT=80
NGINX_SERVER_NAME=_
NGINX_IMAGE=nginx:1.29-alpine
NGINX_CLIENT_MAX_BODY_SIZE=0
NGINX_PROXY_READ_TIMEOUT=3600s
NGINX_PROXY_SEND_TIMEOUT=3600s
SESSION_TTL_HOURS=12
APP_IMAGE=llm-delegate:latest

POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7

POSTGRES_DB=llm_delegate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MAX=20
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=10000
POSTGRES_SSL=false

REDIS_DB=0
REDIS_KEY_PREFIX=llm-delegate:

ROUTE_CONFIG_CACHE_TTL_MS=5000

CLIPROXY_AUTH_DIRS=/root/.cli-proxy-api-1,/root/.cli-proxy-api-2
CLIPROXY_AUTH_DIR_1=/root/.cli-proxy-api-1
CLIPROXY_AUTH_DIR_2=/root/.cli-proxy-api-2
CLIPROXY_AUTH_USAGE_TIMEOUT_MS=10000

DATA_RETENTION_ENABLED=true
DATA_RETENTION_RECENT_REQUESTS_DAYS=90
DATA_RETENTION_STATS_EVENTS_DAYS=90
DATA_RETENTION_COMPLETED_RESERVATIONS_DAYS=30
DATA_RETENTION_INTERVAL_HOURS=24
DATA_RETENTION_RUN_ON_INSTANCE=app-1
