upstream llm_delegate_backend {
    server app-1:${APP_PORT};
    server app-2:${APP_PORT};
    server app-3:${APP_PORT};
    keepalive 32;
}

server {
    listen ${NGINX_LISTEN_PORT};
    server_name ${NGINX_SERVER_NAME};
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    location / {
        proxy_pass http://llm_delegate_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${ESC}host;
        proxy_set_header X-Real-IP ${ESC}remote_addr;
        proxy_set_header X-Forwarded-For ${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host ${ESC}host;
        proxy_set_header X-Forwarded-Proto ${ESC}scheme;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_SEND_TIMEOUT};
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
